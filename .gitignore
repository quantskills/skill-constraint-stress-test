# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Skill runtime output
output/

# 冻结基线：**随包发布**。job 的交付要求里有「冻结基线对照」，而住在被 ignore 目录里的
# 基线对 `git clone` 安装的人根本不存在（本轮实测差点把唯一的真实模型运行锚点丢掉）。
# 只放 JSON 锚点；同目录下的临时文件仍排除。
baselines/*
!baselines/*.json

# 日志
*.log

# 注：fixtures/generated/ 中的评测夹具随仓库发布（确定性、无凭证），
# 保证 clone 后无需凭证即可运行；需要重建时执行
# python3 scripts/fixture_generator.py --manual-only
#
# MCP 原始导出为中间产物，不入库：
# python3 scripts/fixture_generator.py --from-mcp mcp_exports/ --date 20251110
mcp_exports/

# 运行落点默认不入库（可再生、机器本地）。本版起点名放行**本次交付证据**：
# 评分要求「冻结基线对照 / 输入输出索引」，读者要能直接核对实际产物而不是文档转述。
# 注意：只放行具体文件，不放开整个 output/，否则机器本地数据会跟着上公网。
output/*
!output/report.json
!output/agent_decisions_host.json
